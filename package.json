{
  "name": "inventory-system",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "rm -f .next/dev/lock && node scripts/sync-zxing-wasm.mjs && next dev",
    "generate:proto": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --proto_path=./proto/interfaces ./proto/interfaces/dto.proto ./proto/interfaces/present.proto --ts_proto_out=./proto/interfaces --ts_proto_opt=esModuleInterop=true,outputJsonMethods=true",
    "build": "node scripts/sync-zxing-wasm.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:fiscal": "node --experimental-strip-types --test test/fiscal-concordance.test.mjs test/fiscal-fallback.test.mjs test/z-report.test.mjs test/z-report-split.test.mjs test/z-report-day-guard.test.mjs",
    "test:z-guard": "node --experimental-strip-types --test test/z-report-day-guard.test.mjs",
    "test:fiscal-fallback": "node --experimental-strip-types --test test/fiscal-fallback.test.mjs",
    "test:cierre-caja": "node --experimental-strip-types --test test/cierre-caja.test.mjs",
    "test:nota-credito": "node --experimental-strip-types --test test/nota-credito-flow.test.mjs",
    "test:pricing": "node --experimental-strip-types --test test/pricing.test.mjs",
    "test:save-error": "node --experimental-strip-types --test test/save-error.test.mjs",
    "test:inventory": "node --experimental-strip-types --test test/inventory-write.test.mjs",
    "test:store": "node --experimental-strip-types --import ./test/register-loader.mjs --test test/products-store.test.mjs",
    "test:session-binding": "node --experimental-strip-types --test test/cash-session-binding.test.mjs",
    "test:session-binding-load": "node --experimental-strip-types --import ./test/register-loader.mjs --test test/cashier-workflow-load.test.mjs",
    "test:catalog": "node --experimental-strip-types --test test/catalog.test.mjs",
    "test:barcode": "node --experimental-strip-types --test test/barcode-resolve.test.mjs",
    "sync:zxing-wasm": "node scripts/sync-zxing-wasm.mjs",
    "test:scanner": "node --experimental-strip-types --test modules/scanner/lib/barcode-lookup.test.mjs modules/scanner/lib/stream-abandonment.test.mjs modules/scanner/lib/barcode-acceptance.test.mjs modules/scanner/lib/stock-adjustment.test.mjs modules/scanner/lib/stock-adjust-contract.test.mjs",
    "test:date-utils": "TZ=America/Caracas node --experimental-strip-types --test test/date-utils.test.mjs",
    "test:quote": "node --experimental-strip-types --import ./test/register-loader.mjs --test test/quote-pdf.test.mjs",
    "test:local-sale": "node --experimental-strip-types --test test/local-sale-persist.test.mjs",
    "test:local-sale-cart": "node --experimental-strip-types --import ./test/register-loader.mjs --test test/local-sale-fiscal-cart.test.mjs",
    "test:facturas-date": "TZ=America/Caracas node --experimental-strip-types --import ./test/register-loader.mjs --test modules/facturas/lib/date-presets.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "jspdf": "^2.5.1",
    "long": "^5.3.2",
    "mqtt": "^5.15.1",
    "next": "16.1.5",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "ts-proto": "^2.11.6",
    "ulid": "^3.0.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.10",
    "zxing-wasm": "^3.1.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
